# Postgres (docker compose up -d)
DATABASE_URL=postgresql://rag:rag@localhost:5433/ragdb

# Provider: "ollama" (local, default) or "bedrock" (AWS)
PROVIDER=ollama

# Ollama (local, no API key, no cost)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
CHAT_MODEL=qwen2.5:14b

# AWS Bedrock. Only used when PROVIDER=bedrock.
# Credentials come from the standard boto3 chain (env, ~/.aws, instance role).
# Titan v2 is 1024-dimensional: set EMBED_DIM=1024 and re-ingest when switching.
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Reranking: "cross-encoder" (default, fast and local), "llm", or "none"
RERANKER=cross-encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval
VECTOR_TOP_K=30
KEYWORD_TOP_K=30
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=0.2
RERANK_TOP_N=8
CONTEXT_CHUNKS=5
